// =========================================================================
// Threat Hunt: Explicit Credential Usage (RunAs / Secondary Logon)
// MITRE ATT&CK: Defense Evasion / Privilege Escalation (T1078.002)
// Target Table: SecurityEvent
// Description: Detects processes spawned with alternate user credentials (Event ID 4648).
// =========================================================================

SecurityEvent
| where EventID == 4648
| project 
    TimeGenerated,
    Account,
    TargetUserName,
    TargetServerName,
    TargetProcessName,
    ProcessName,
    Computer
| order by TimeGenerated desc
